imports:
  - ./vendor/oro/platform/src/Oro/Bundle/TestFrameworkBundle/Resources/config/behat.yml.dist

default: &default
    gherkin:
        filters:
            tags: ~@not-automated&&~@skip
    extensions:
        Behat\MinkExtension:
            base_url: '%env(default:oro_test.behat.base_url:ORO_BEHAT_BASE_URL)%'
        FriendsOfBehat\SymfonyExtension:
            kernel:
              debug: false
              class: AppKernel
        Oro\Bundle\TestFrameworkBundle\Behat\ServiceContainer\OroTestFrameworkExtension:
            # When true, the Playwright driver replaces the driver of all Mink sessions,
            # also the oroSelenium2 sessions from an outer behat.yml.
            # ORO_BEHAT_PLAYWRIGHT replaces this value. Set it for composer install too,
            # to install the browser. ORO_PLAYWRIGHT_HEADED=1 shows the browser window.
            playwright_driver: false

chromedriver:
    <<: *default

playwright:
    <<: *default
